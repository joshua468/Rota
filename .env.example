# Names only. Never put a value in this file.
# Copy the names you need into a local `.env` (gitignored); the backend reads
# `backend/.env` at boot and refuses to start on a missing/invalid value.

## Backend (validated by backend/src/env.ts)
NODE_ENV
PORT
DATABASE_URL
SHARD_DATABASE_URLS
SHARD_COUNT
DB_DRIVER
DB_SSL
DB_CONNECTION_TIMEOUT_MS
DB_STATEMENT_TIMEOUT_MS
REDIS_URL
CRON_SECRET
JWT_SECRET
PUBLIC_BASE_URL
CORS_ORIGINS
TRUST_PROXY
FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_HASH
EXPO_ACCESS_TOKEN
SENTRY_DSN
FEATURE_SWAP_ASSIST
OPENAI_API_KEY
MAIL_DRIVER
MAIL_FROM
RESEND_API_KEY

## Frontend
EXPO_PUBLIC_API_URL
EXPO_PUBLIC_SENTRY_DSN
EXPO_PUBLIC_APP_SCHEME
# Only these three are allowed. No secrets in the frontend bundle.

## EAS release metadata (frontend/app.config.js)
EAS_PROJECT_ID
EAS_OWNER
EAS_CHANNEL
